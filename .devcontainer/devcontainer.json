{
	"name": "Bazel (Community)",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"BAZELISK_VERSION": "v1.30.0",
			"BAZELISK_DOWNLOAD_SHA": "a248ae2b2b62b5baebb748f6fba7203bff1a27e5d01b55399a8406744cb539e8"
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-vscode.cpptools-extension-pack",
				"BazelBuild.vscode-bazel",
				"minherz.copyright-inserter",
				"DavidAnson.vscode-markdownlint",
				"yzhang.markdown-all-in-one",
				"ms-python.black-formatter",
				"ms-toolsai.jupyter",
				"ms-toolsai.tensorboard"
			]
		}
	},

	"mounts": [ "source=/tmp,target=/tmp,type=bind,consistency=cached" ],
	"remoteUser": "vscode"
}
