module(
    name = "hadal_flow",
    version = "0.8.1",
)

SUPPORTED_PYTHON_VERSIONS = [
    "3.10",
    "3.11",
    "3.12",
    "3.13",
]  # Also see ./.github/workflows/wheel.yaml

DEFAULT_PYTHON = "3.12"  # Also see ./BUILD

bazel_dep(name = "rules_python", version = "2.4.6")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

[
    python.toolchain(
        is_default = version == DEFAULT_PYTHON,
        python_version = version,
    )
    for version in SUPPORTED_PYTHON_VERSIONS
]

use_repo(
    python,
    "python_versions",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

[
    pip.parse(
        hub_name = "pip",
        python_version = version,
        requirements_lock = "//:requirements_" + version.replace(".", "_") + ".txt",
    )
    for version in SUPPORTED_PYTHON_VERSIONS
]

use_repo(pip, "pip")

# Since we compile against the tensorflow headers which make heavy use of
# abseil, the version used here must match the version used by tensorflow.
# See what version of abseil tensorflow is using here:
# https://github.com/tensorflow/tensorflow/blob/master/tensorflow/lite/tools/cmake/modules/abseil-cpp.cmake#L27
bazel_dep(name = "abseil-cpp", version = "20250814.2", repo_name = "com_google_absl")
single_version_override(
    module_name = "abseil-cpp",
    version = "20250814.2",
)

# Additionally, tensorflow headers use a protobuf version which which is a
# python dependency. Other dependencies (like rules_cc >= 0.0.13 and tink_cc)
# also use protobuf, so the versions must match.
# See what version tensorflow is using here:
# https://github.com/tensorflow/tensorflow/blob/master/tensorflow/lite/tools/cmake/modules/protobuf.cmake
# Or look at the proto files directly:
# bazel-out/k8-opt/bin/external/_main~_repo_rules~shell_encryption/shell_encryption/serialization.pb.h
bazel_dep(name = "protobuf", version = "31.1")
single_version_override(
    module_name = "protobuf",
    version = "31.1",
)

# Note, rule_cc is limited by the protobuf version required by
# TensorFlow. That makes updating remaining deps below difficult.
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "glog", version = "0.7.1.bcr.2", repo_name = "com_github_google_glog")
bazel_dep(name = "boringssl", version = "0.20261020.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "tink_cc", version = "2.9.2", repo_name = "com_github_tink_crypto_tink_cc")
bazel_dep(name = "rules_foreign_cc", version = "0.17.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "highway", version = "1.4.0.bcr.1", repo_name = "com_github_google_highway")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "shell_encryption",
    integrity = "sha256-Nv21oOqACAyaw77ppgRwu8zNbhLDTR6Sb6ARYXCa92c=",
    patch_cmds = [
        "sed -i '/rust_proto_library/d; /rns_serialization_rust_proto/,+2d' shell_encryption/rns/BUILD",
    ],
    strip_prefix = "shell-encryption-e81ce950f875ad183b92fff5d35efa35fb9cd9aa",
    urls = ["https://github.com/google/shell-encryption/archive/e81ce950f875ad183b92fff5d35efa35fb9cd9aa.zip"],
)

_ALL_CONTENT = """\
filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
"""

http_archive(
    name = "emp-tool",
    build_file_content = _ALL_CONTENT,
    integrity = "sha256-EKVeWz5hav6jMtl0CIGZzA0KkyeCSVhUJ7dSJayBWMg=",
    strip_prefix = "emp-tool-0.3.0",
    urls = ["https://github.com/emp-toolkit/emp-tool/archive/refs/tags/0.3.0.zip"],
)

http_archive(
    name = "emp-ot",
    build_file_content = _ALL_CONTENT,
    integrity = "sha256-/ePcH7KaWMFVSAsbNhpCXEznrt0BuZvjMvNCPCYhH4Q=",
    strip_prefix = "emp-ot-0.3.0",
    urls = ["https://github.com/emp-toolkit/emp-ot/archive/refs/tags/0.3.0.zip"],
)

http_archive(
    name = "emp-sh2pc",
    build_file_content = _ALL_CONTENT,
    integrity = "sha256-O9GecRE3qbkNmOtej2T9nHJhYe+FeXbvTNXkAW+dZZM=",
    strip_prefix = "emp-sh2pc-0.3.0",
    urls = ["https://github.com/emp-toolkit/emp-sh2pc/archive/refs/tags/0.3.0.zip"],
)
